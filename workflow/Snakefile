# Ancestry inference with Ancestry HMM and ancestry association analysis

import pandas
import numpy as np


# Helper functions

def get_chrom_code(wildcards):
    """Map a chromosome label to the corresponding numeric code, 'X' -> 4"""
    df = pandas.read_csv(
        "../data/chr_map.txt", sep="\\s+", names=["label", "code"])
    mapping = {label: code for label, code in zip(df["label"], df["code"])}
    return mapping[wildcards.chrom]


# Constants. It would be better for ``CHROMS`` to be called ``ARMS``.

CHROMS = ["2L", "2R", "3L", "3R", "X"]
SAMPLES = []
with open("../results/DGRP_samples.txt", "r") as fin:
    for line in fin:
        SAMPLES.append(line.strip())


# End-product files produced by the pipeline

rule all:
    input:
        "../results/ancestry/DGRP_ancestry_c.tsv",


# Create some input data

rule index_input_vcfs:
    # Index input VCF files
    input:
        "../data/vcfs/{dataset}.vcf.gz"
    output:
        "../data/vcfs/{dataset}.vcf.gz.csi"
    shell:
        """
        bcftools index {input}
        """

rule rebuild_rec_map:
    # Make some alterations to the input recombination map. Most significantly,
    # extend the map to chromosome arm starts/ends with rate 0.01 cM/Mb and
    # rename arms from numeric codes to strings, e.g. 7 -> 2R.
    input:
        script="scripts/rebuild_recomb.py",
        rec_map="../data/recomb_r6_num.tsv",
        labels="../data/chr_map.txt",
        genome="../data/r6.genome"
    output:
        "../results/recomb_r6.tsv"
    shell:
        """
        python {input.script} \
            -i {input.rec_map} \
            -l {input.labels} \
            -g {input.genome} \
            -o {output}
        """


# Extract sample labels from VCFs

rule extract_dgrp_sample_names:
    # Extract sample names from the DGRP VCF file.
    input:
        "../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz"
    output:
        "../results/DGRP_samples.txt"
    shell:
        """
        bcftools query -l {input} > {output}
        """

rule extract_panel_sample_names:
    # Extract sample names from the ZI, ET, FR panel and subset to ZI, FR
    input:
        "../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz"
    output:
        "../results/FR_ZI_samples.txt"
    shell:
        """
        bcftools query -l {input} | grep 'FR\|ZI' > {output}
        """

rule make_ahmm_to_vcf_sample_file:
    # Create a sample file for preparing Ancestry HMM input, with this format:
    #   sample_FR_0 0
    #   sample_FR_1 0
    #   sample_ZI_0 1
    #   sample_ZI_1 1
    #   sample_DGRP admixed
    input:
        dgrp="../results/DGRP_samples.txt",
        panel="../results/ZI_FR_samples.txt"
    output:
        "../results/VCF_to_AHMM.samples"
    shell:
        """
        grep FR {input.panel} | awk '{{print $0 "\t0"}}' > {output}
        grep ZI {input.panel} | awk '{{print $0 "\t1"}}' >> {output}
        awk '{{print $0 "\tadmixed"}}' {input.dgrp} >> {output}
        """

rule make_ahmm_sample_file:
    # Add a column with ploidy (`2`) to the DGRP sample list.
    input:
        "../results/DGRP_samples.txt"
    output:
        "../results/DGRP_AHMM.samples"
    shell:
        """
        awk '{{print $0 "\t2"}}' {input} > {output}
        """


# Simplify VCFs and split them by chromosome

rule split_raw_dgrp_vcf:
    # Simplify the DGRP-3 VCF and split it by chromosome.
    # bcftools view arguments:
    #   -r : Subset to arm {wilcards.chrom}.
    #   -v snps : Subset to SNPs (the input file includes indels).
    # bcftools annotate arguments:
    #   -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ : Drop all INFO fields and all
    #       FORMAT fields except GT:AD:GQ.
    #   -W : Index the output file.
    input:
        "../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz",
        index="../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz.csi"
    output:
        "../results/vcfs/DGRP_{chrom}.vcf.gz"
    shell:
        """
        bcftools view -r {wildcards.chrom} -v snps {input} | \
            bcftools annotate -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ -W -o {output}
        """

rule split_raw_panel_vcf:
    # Subset, split by chromosome, and simplify the ZI, ET, FR panel VCF.
    # Map chromosome labels from numeric codes to strings, e.g. 7 -> 2R.
    # bcftools view arguments:
    #   -S : Subset samples to samples in {input.samples}
    #   -r : Subset sites to {wildcards.chrom_code}
    # bcftools annotate arguments:
    #   --rename-chrs : Maps chromosome names as described above.
    #   -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ : Drop all INFO fields and all
    #       FORMAT fields except GT:AD:GQ.
    #   -W : Index the output file.
    input:
        vcf="../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz",
        index="../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz.csi",
        chrom_map="../data/inverse_chr_map.txt",
        samples="../results/FR_ZI_samples.txt"
    output:
        "../results/vcfs/FR_ZI_{chrom}.vcf.gz"
    params:
        chrom_code = get_chrom_code
    shell:
        """
        bcftools view -S {input.samples} -r {params.chrom_code} {input.vcf} | \
            bcftools annotate --rename-chrs {input.chrom_map} \
            -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ -W -o {output}
        """


# Extract information about VCF contents

rule extract_site_data:
    # Extract position, reference/alternate allele, and alternate allele
    # count from chromosome and dataset (DGRP, FR/ZI)-specific VCFs.
    input:
        "../results/vcfs/{label}_{chrom}.vcf.gz"
    output:
        "../results/site_data/{label}_{chrom}.tsv"
    shell:
        """
        bcftools +fill-tags {input} | \
            bcftools query -f'%CHROM\t%POS\t%REF\t%ALT\t%AC\n' > {output}
        """

rule merge_site_data:
    input:
        script="scripts/build_ref_alt_table.py",
        fr_zi="../results/site_info/FR_ZI_{chrom}.tsv",
        dgrp="../results/site_info/DGRP_{chrom}.tsv"
    output:
        "../results/site_info/merged_{chrom}.tsv"
    shell:
        """
        python {input.script} \
            -i {input.fr_zi} {input.dgrp} \
            --labels panel dgrp \
            -o {output}
        """


# Merge VCFs

rule merge_vcfs:
    # Merge DGRP and panel VCFs and drop sites that aren't biallelic SNPs
    # Bcftools flags:
    #   -m2 -M2 : Keep only biallelic sites
    #   -g ^miss : Keep only sites with no missing genotypes. Because there is
    #       no missingness in the DGRP-3 or panel VCF files, missing sites in
    #       the merged file should be sites where the minor allele is private
    #       to the DGRP or panels; such sites are not useful to us.
    #   -W : Create an index file for the output VCF
    input:
        dgrp="../results/vcfs/DGRP_{chrom}.vcf.gz",
        fr_zi="../results/vcfs/FR_ZI_{chrom}.vcf.gz"
    output:
        "../results/vcfs/merged_FR_ZI_DGRP_{chrom}.vcf.gz"
    shell:
        """
        bcftools merge {input.fr_zi} {input.dgrp} | \
            bcftools view -m2 -M2 -g ^miss -W -o {output}
        """


# Create AncestryHMM input files

rule make_ahmm_inputs:
    # Create a file formatted as input to Ancestry HMM for the entire DGRP
    # dataset, with FR and ZI panels as ancestral proxies.
    # Arguments:
    #   -g 1 : Use genotype information instead of read counts.
    #   -m 1 : Minimum spacing between SNPs (e.g., use all SNPs).
    #   --min-diff 0 : Minimum allele frequency difference between panel
    #       populations (e.g., use all SNPs).
    input:
        script="scripts/vcf_to_ahmm.py",
        vcf="../results/vcfs/merged_FR_ZI_DGRP_{chrom}.vcf.gz",
        samples="../results/VCF_to_AHMM.samples",
        rec="../results/recomb_r6.tsv"
    output:
        table="../results/AHMM_inputs/FR_ZI_DGRP_{chrom}.tsv"
    shell:
        """
        python {input.script} \
            --vcf {input.vcf} \
            --samples {input.samples} \
            --rec {input.rec} \
            -g 1 \
            -m 1 \
            --min-diff 0 \
            > {output.table}
        """

rule concatenate_ahmm_inputs:
    # Concatenate all chromosome-specific Ancestry HMM input tables into a
    # single file.
    input:
        expand("../results/AHMM_inputs/FR_ZI_DGRP_{chrom}.tsv",
               chrom=CHROMS)
    output:
        "../results/AHMM_inputs/FR_ZI_DGRP_all.tsv"
    shell:
        """
        cat {input} > {output}
        """


rule split_ahmm_inputs:
    # Split AHMM input files so that each DGRP sample has its own file
    # (to reduce the speed of AHMM runs and allow parallelization).
    input:
        script="scripts/split_ahmm_input.py",
        table="../results/AHMM_inputs/FR_ZI_DGRP_all.tsv",
        samples="../results/VCF_to_AHMM.samples"
    output:
        tables=expand("../results/AHMM_inputs/split/{sample}.tsv",
                      sample=SAMPLES),
        samples=expand("../results/AHMM_inputs/split/{sample}.samples",
                       sample=SAMPLES)
    params:
        prefix="../results/AHMM_inputs/split/"
    shell:
        """
        python {input.script} \
            -i {input.table} \
            -s {input.samples} \
            -o {params.prefix}
        """


# Run AncestryHMM

rule run_ancestry_hmm:
    # Run Ancestry HMM on sample-specific input files.
    # Ancestry HMM arguments:
    #   -a 2 0.8 0.2 : Specify two ancestral populations (FR and ZI), with
    #       prior ancestry probabilities 80%, 20%
    #   -p 0 0.8 1598 : Ancestry 0 (FR) contributed 80% of ancestry 1598
    #       generations ago (parameters from Pool, 2015).
    #   -p 0 0.2 1598 : Ancestry 1 (ZI) contributed 20% of ancestry 1598
    #       generations ago
    #   -ne 2500000 : Effective population size of the admixed population.
    #   -g : Use genotype information rather than read counts.
    input:
        table="../results/AHMM_inputs/split/{sample}.tsv",
        samples="../results/AHMM_inputs/split/{sample}.samples"
    output:
        "../results/AHMM_outputs/{sample}.posterior"
    params:
        out="{sample}.posterior",
        dir="../results/AHMM_outputs/"
    shell:
       """
        ancestry_hmm -i {input.table} \
            -s {input.samples} \
            -a 2 0.8 0.2 \
            -p 0 0.8 1598 \
            -p 1 0.2 1598 \
            -ne 2500000 \
            -g
        mv {params.out} {params.dir}
        """


# Build tables with maximum a posterior ancestries for each sample

rule buld_ancestry_table:
    # Call ancestries using maximum a posteriori (MAP) ancestry probability
    # and merge samples into one large ancestry table.
    input:
        script="scripts/merge_ahmm_outputs.py",
        tables=expand("../results/AHMM_outputs/{sample}.posterior",
                      sample=SAMPLES),
        samples="../results/VCF_to_AHMM.samples",
    output:
        "../results/ancestry/DGRP_ancestry.tsv"
    shell:
        """
        python {input.script} \
            -i {input.tables} \
            -s {input.samples} \
            -o {output}
        """

rule add_ancestry_recomb_rate_column:
    # Add a column with the recombination rate at each SNP to the ancestry
    # table.
    input:
        ancestry="../results/ancestry/DGRP_ancestry.tsv",
        split_input=f"../results/AHMM_inputs/split/{SAMPLES[0]}.tsv"
    output:
        table="../results/ancestry/DGRP_ancestry_c.tsv"
    run:
        df = pandas.read_csv(input.split_input, sep="\t", names=range(9))
        c = df[6]  # recombination rate
        df = pandas.read_csv(input.ancestry, sep="\t")
        df["c"] = c
        cols = list(df.columns)
        cols.pop(-1)
        cols.insert(2, "c")
        df = df[cols]
        df.to_csv(output.table, sep="\t", index=False)


# Compute Fisher Exact Tes (FET) p-values for pairwise site ancestry

rule compute_fet_pvals:
    input:
        script="scripts/compute_fet_pvals.py",
        anc_table="../results/ancestry/DGRP_ancestry_c.tsv"
    output:
        bins_table="../results/FET_pvals/{arm1}_{arm2}_FET_binned_pvals.tsv",
        site_table="../results/FET_pvals/{arm1}_{arm2}_FET_site_pvals.tsv"
    shell:
        """
        python {input.script} \
            -i {input.anc_table} \
            --arm1 {wildcards.arm1} \
            --arm2 {wildcards.arm2} \
            --threshold 1e-5 \
            -b {output.bins_table} \
            -s {output.site_table}
        """

