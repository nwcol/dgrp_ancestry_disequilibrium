
import pandas
import numpy as np


# Helper functions

def get_chrom_code(wildcards):
    """Map a chromosome label to the corresponding numeric code, 'X' -> 4"""
    df = pandas.read_csv(
        "../data/chr_map.txt", sep="\\s+", names=["label", "code"])
    mapping = {label: code for label, code in zip(df["label"], df["code"])}
    return mapping[wildcards.chrom]


# End-product output files

CHROMS = ["2L", "2R", "3L", "3R", "X"]
SAMPLES = []
with open("../results/DGRP_samples.txt", "r") as fin:
    for line in fin:
        SAMPLES.append(line.strip())


rule all:
    input:
        expand("../results/AHMM_outputs/{sample}.posterior", sample=SAMPLES),
        "../results/ancestry/DGRP-2_subset_ancestry.tsv",
        "../results/ancestry/DGRP-3_ancestry.tsv",


# Create some input data

rule index_input_vcfs:
    # Index input VCF files
    input:
        "../data/vcfs/{dataset}.vcf.gz"
    output:
        "../data/vcfs/{dataset}.vcf.gz.csi"
    shell:
        """
        bcftools index {input}
        """

rule format_rec_map:
    # Make some alterations to the input recombination map
    input:
        script="scripts/format_rec_map.py",
        rec_map="../data/recomb_r6_num.tsv",
        labels="../data/chr_map.txt"
    output:
        "../results/rec_map_build6.tsv"
    shell:
        """
        python {input.script} -i {input.rec_map} -l {input.labels} -o {output}
        """


# Extract sample labels from VCFs

rule extract_dgrp_sample_names:
    input:
        "../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz"
    output:
        "../results/DGRP_samples.txt"
    shell:
        """
        bcftools query -l {input} > {output}
        """

rule extract_panel_sample_names:
    # Extract sample names from the ZI, ET, FR panel and subset to ZI, FR
    input:
        "../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz"
    output:
        "../results/FR_ZI_samples.txt"
    shell:
        """
        bcftools query -l {input} | grep 'FR\|ZI' > {output}
        """

rule make_ahmm_to_vcf_sample_file:
    # Create a file with this format:
    #   sample_FR_0 0
    #   sample_FR_1 0
    #   sample_ZI_0 1
    #   sample_ZI_1 1
    #   sample_DGRP admixed
    input:
        dgrp="../results/DGRP_samples.txt",
        panel="../results/ZI_FR_samples.txt"
    output:
        "../results/VCF_to_AHMM.samples"
    shell:
        """
        grep FR {input.panel} | awk '{{print $0 "\t0"}}' > {output}
        grep ZI {input.panel} | awk '{{print $0 "\t1"}}' >> {output}
        awk '{{print $0 "\tadmixed"}}' {input.dgrp} >> {output}
        """

rule make_ahmm_sample_file:
    # Add a column with ploidy (`2`) to the DGRP sample list.
    input:
        "../results/DGRP_samples.txt"
    output:
        "../results/DGRP_AHMM.samples"
    shell:
        """
        awk '{{print $0 "\t2"}}' {input} > {output}
        """


# Simplify VCFs and split them by chromosome

rule split_raw_dgrp_vcf:
    # Simplify the DGRP-3 VCF and split it by chromosome.
    # Bcftools options:
    #   -v snps: Include only SNPs (raw file includes indels)
    input:
        "../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz",
        index="../data/vcfs/DGRP-3_final_biallelic-new.vcf.gz.csi"
    output:
        "../results/vcfs/DGRP_{chrom}.vcf.gz"
    shell:
        """
        bcftools view -r {wildcards.chrom} -v snps {input} | \
            bcftools annotate -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ -W -o {output}
        """

rule split_raw_panel_vcf:
    # Subset, split by chromosome, and simplify the ZI, ET, FR panel VCF.
    # Map chromosome labels from numeric codes to strings, e.g. 7 -> 2R.
    input:
        vcf="../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz",
        index="../data/vcfs/ZI_ET_FR_combined_all_num_biallelic.vcf.gz.csi",
        chrom_map="../data/inverse_chr_map.txt",
        samples="../results/FR_ZI_samples.txt"
    output:
        "../results/vcfs/FR_ZI_{chrom}.vcf.gz"
    params:
        chrom_code = get_chrom_code
    shell:
        """
        bcftools view -S {input.samples} -r {params.chrom_code} {input.vcf} | \
            bcftools annotate --rename-chrs {input.chrom_map} \
            -x INFO,^FORMAT/GT,FORMAT/AD,FORMAT/GQ -W -o {output}
        """


# Extract information about VCF contents

rule extract_ref_alt:
    # Extract position, reference/alternate allele, and alternate allele
    # count from chromosome and dataset (DGRP, FR/ZI)-specific VCFs.
    input:
        "../results/vcfs/{label}_{chrom}.vcf.gz"
    output:
        "../results/vcf_info/ref_alt_{label}_{chrom}.tsv"
    shell:
        """
        bcftools +fill-tags {input} | \
            bcftools query -f'%CHROM\t%POS\t%REF\t%ALT\t%AC\n' > {output}
        """

rule merge_ref_alt:
    input:
        script="scripts/merge_ref_alt_tables.py",
        fr_zi="../results/vcf_info/FR_ZI_{chrom}.tsv",
        dgrp="../results/vcf_info/DGRP_{chrom}.tsv"
    output:
        "../results/vcf_info/ref_alt_FR_ZI_DGRP.tsv"
    shell:
        """
        python {input.script} \
            -i {input.fr_zi} {input.dgrp} \
            --labels panel dgrp \
            -o {output}
        """


# Merge VCFs

rule merge_vcfs:
    # Merge DGRP and panel VCFs and drop sites that aren't biallelic SNPs
    # Bcftools flags:
    #   -m2 -M2: Keeps only biallelic sites
    #   -g ^miss: Keep only lines with no missing genotypes
    #   -W: Create an index file for the output VCF
    input:
        dgrp="../results/vcfs/DGRP_{chrom}.vcf.gz",
        fr_zi="../results/vcfs/FR_ZI_{chrom}.vcf.gz"
    output:
        "../results/vcfs/merged_FR_ZI_DGRP_{chrom}.vcf.gz"
    shell:
        """
        bcftools merge {input.fr_zi} {input.dgrp} | \
            bcftools view -m2 -M2 -g ^miss -W -o {output}
        """


# Create AncestryHMM input files

rule make_ahmm_inputs:
    # 
    input:
        script="scripts/vcf_to_ahmm.py",
        vcf="../results/vcfs/merged_FR_ZI_DGRP_{chrom}.vcf.gz",
        samples="../results/VCF_to_AHMM.samples",
        rec="../data/recomb_build6.tsv"
    output:
        table="../results/AHMM_inputs/FR_ZI_DGRP_{chrom}.tsv",
        samples="../results/AHMM_inputs/FR_ZI_DGRP_{chrom}.samples"
    shell:
        """
        python {input.script} \
            --vcf {input.vcf} \
            --samples {input.samples} \
            --rec {input.rec} \
            -g 1 \
            -o {output.samples} \
            > {output.table}
        """

rule copy_sample_file:
    input:
        "../results/AHMM_inputs/FR_ZI_DGRP_2L.samples"
    output:
        "../results/AHMM_inputs/FR_ZI_DGRP.samples"
    shell:
        """
        cp {input} {output}
        """

rule concatenate_ahmm_inputs:
    # Concatenate all chromosome-specific Ancestry HMM input tables into a
    # single file.
    input:
        expand("../results/AHMM_inputs/FR_ZI_DGRP_{chrom}.tsv",
               chrom=CHROMS)
    output:
        "../results/AHMM_inputs/FR_ZI_DGRP.tsv"
    shell:
        """
        cat {input} > {output}
        """

rule split_ahmm_inputs:
    # Split AHMM input files so that each DGRP sample has its own file
    # (to reduce the speed of AHMM runs and allow parallelization)
    input:
        script="scripts/split_ahmm_samples.py",
        table="../results/AHMM_inputs/FR_ZI_DGRP.tsv",
        samples="../results/VCF_to_AHMM.samples"
    output:
        tables=expand("../results/AHMM_inputs/FR_ZI_{sample}.tsv",
                      sample=SAMPLES),
        samples=expand("../results/AHMM_inputs/FR_ZI_{sample}.samples",
                       sample=SAMPLES)
    params:
        prefix="../results/AHMM_inputs/FR_ZI"
    shell:
        """
        python {input.script} \
            -i {input.table} \
            -s {input.samples} \
            -o {params.prefix}
        """


# Run AncestryHMM

rule run_ancestry_hmm:
    # Run Ancestry HMM on sample-specific input files.
    # Ancestry HMM arguments:
    #   -a 2 0.8 0.2: Specify two ancestral populations (FR and ZI), with
    #                 prior ancestry probabilities 80%, 20%
    #   etc
    input:
        table="../results/AHMM_inputs/FR_ZI_{sample}.tsv",
        samples="../results/AHMM_inputs/FR_ZI_{sample}.samples"
    output:
        "../results/AHMM_outputs/{sample}.posterior"
    params:
        out="{sample}.posterior",
        dir="../results/AHMM_outputs/"
    shell:
        """
        ancestry_hmm -i {input.table} \
            -s {input.samples} \
            -a 2 0.8 0.2 \
            -p 0 0.8 1598 \
            -p 1 0.2 1598 \
            -ne 2500000 \
            -g
        mv {params.out} {params.dir}
        """


# Build tables with maximum a posterior ancestries for each sample

